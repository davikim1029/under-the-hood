{
  "name": "under-the-hood-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "under-the-hood": "./main.py"
  },
  "scripts": {
    "cli": "python3 main.py",
    "node-cli": "node cli.mjs",
    "dev": "node server.mjs",
    "tailnet": "UTH_BIND=tailnet node server.mjs",
    "agent": "UTH_BIND=0.0.0.0 node server.mjs",
    "funnel": "sh scripts/tailscale.sh funnel --bg ${PORT:-5173}",
    "start-server": "python3 main.py --mode start-server",
    "stop-server": "python3 main.py --mode stop",
    "restart-server": "python3 main.py --mode restart",
    "health": "python3 main.py --mode health",
    "url": "python3 main.py --mode url",
    "start": "node server.mjs",
    "check": "python3 -m py_compile main.py && node --check server.mjs && node --check cli.mjs && node --check public/app.js"
  },
  "engines": {
    "node": ">=18"
  }
}
